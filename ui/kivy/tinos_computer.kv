#:kivy 2.0.0

# Tino's Computer - Kivy UI Layout
# Color scheme matches the other UI versions

#:set bg_color (0.9, 0.95, 1, 1)  # Soft blue background
#:set blue_color (0.26, 0.52, 0.96, 1)  # Bright blue
#:set teal_color (0.2, 0.66, 0.33, 1)  # Teal
#:set red_color (1, 0.8, 0.82, 1)  # Light red
#:set green_color (0.78, 0.9, 0.79, 1)  # Light green
#:set light_blue_color (0.73, 0.87, 0.98, 1)  # Light blue
#:set purple_color (0.82, 0.77, 0.91, 1)  # Light purple
#:set yellow_color (0.98, 0.74, 0.02, 1)  # Yellow

# Global styles
<Button>:
    font_size: '20sp'
    size_hint: None, None
    size: 200, 200
    background_normal: ''
    background_color: (1, 1, 1, 1)
    border: (10, 10, 10, 10)
    color: (0, 0, 0, 1)
    font_name: 'Comic Sans MS'

<Label>:
    font_name: 'Comic Sans MS'
    color: (0, 0, 0, 1)

<Screen>:
    canvas.before:
        Color:
            rgba: bg_color
        Rectangle:
            pos: self.pos
            size: self.size

# Home Screen
<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 20
        
        # Header with clock and weather
        BoxLayout:
            size_hint_y: 0.2
            padding: 10
            canvas.before:
                Color:
                    rgba: (1, 1, 1, 0.7)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20, 20, 20, 20]
            
            # Clock container
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.5
                
                Label:
                    text: root.current_time
                    font_size: '48sp'
                    color: blue_color
                    bold: True
                
                Label:
                    text: root.current_date
                    font_size: '24sp'
                    color: teal_color
            
            # Weather container
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.5
                
                Label:
                    text: '☀️'
                    font_size: '48sp'
                
                Label:
                    text: '72°'
                    font_size: '36sp'
                    bold: True
        
        # App grid
        GridLayout:
            cols: 2
            spacing: 30
            size_hint_y: 0.8
            
            # Music button
            Button:
                text: 'Music'
                background_color: red_color
                on_release: app.root.current = 'music'
                BoxLayout:
                    orientation: 'vertical'
                    pos: self.parent.pos
                    size: self.parent.size
                    
                    Label:
                        text: '🎵'
                        font_size: '64sp'
                    
                    Label:
                        text: 'Music'
                        font_size: '24sp'
                        bold: True
            
            # Stories button
            Button:
                text: 'Stories'
                background_color: green_color
                on_release: app.root.current = 'stories'
                BoxLayout:
                    orientation: 'vertical'
                    pos: self.parent.pos
                    size: self.parent.size
                    
                    Label:
                        text: '📚'
                        font_size: '64sp'
                    
                    Label:
                        text: 'Stories'
                        font_size: '24sp'
                        bold: True
            
            # Games button
            Button:
                text: 'Games'
                background_color: light_blue_color
                on_release: app.root.current = 'games'
                BoxLayout:
                    orientation: 'vertical'
                    pos: self.parent.pos
                    size: self.parent.size
                    
                    Label:
                        text: '🎮'
                        font_size: '64sp'
                    
                    Label:
                        text: 'Games'
                        font_size: '24sp'
                        bold: True
            
            # Settings button
            Button:
                text: 'Settings'
                background_color: purple_color
                on_release: app.root.current = 'settings'
                BoxLayout:
                    orientation: 'vertical'
                    pos: self.parent.pos
                    size: self.parent.size
                    
                    Label:
                        text: '⚙️'
                        font_size: '64sp'
                    
                    Label:
                        text: 'Settings'
                        font_size: '24sp'
                        bold: True

# Music Screen
<MusicScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 20
        
        # Header with back button
        BoxLayout:
            size_hint_y: 0.1
            spacing: 10
            
            Button:
                text: '← Back'
                size_hint: None, None
                size: 150, 60
                background_color: blue_color
                color: (1, 1, 1, 1)
                on_release: app.root.current = 'home'
            
            Label:
                text: 'Music Player'
                font_size: '36sp'
                bold: True
                size_hint_x: 1
                halign: 'left'
                text_size: self.size
                valign: 'middle'
        
        # Music content
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.9
            spacing: 20
            
            # Album art
            Image:
                source: 'placeholder-album.png'  # Replace with actual image
                size_hint: None, None
                size: 300, 300
                pos_hint: {'center_x': 0.5}
                # Fallback if image not found
                canvas.before:
                    Color:
                        rgba: (0.8, 0.8, 0.8, 1)
                    Rectangle:
                        pos: self.pos
                        size: self.size
            
            # Song info
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.2
                
                Label:
                    text: root.song_title
                    font_size: '28sp'
                    bold: True
                
                Label:
                    text: root.artist_name
                    font_size: '20sp'
                    color: (0.4, 0.4, 0.4, 1)
            
            # Player controls
            BoxLayout:
                size_hint_y: 0.2
                spacing: 20
                pos_hint: {'center_x': 0.5}
                size_hint_x: 0.5
                
                Button:
                    text: '⏮️'
                    font_size: '48sp'
                    background_color: (0, 0, 0, 0)
                    on_release: root.previous_song()
                
                Button:
                    text: '⏸️' if root.is_playing else '▶️'
                    font_size: '48sp'
                    background_color: (0, 0, 0, 0)
                    on_release: root.toggle_play()
                
                Button:
                    text: '⏭️'
                    font_size: '48sp'
                    background_color: (0, 0, 0, 0)
                    on_release: root.next_song()

# Stories Screen
<StoriesScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 20
        
        # Header with back button
        BoxLayout:
            size_hint_y: 0.1
            spacing: 10
            
            Button:
                text: '← Back'
                size_hint: None, None
                size: 150, 60
                background_color: blue_color
                color: (1, 1, 1, 1)
                on_release: app.root.current = 'home'
            
            Label:
                text: 'Stories'
                font_size: '36sp'
                bold: True
                size_hint_x: 1
                halign: 'left'
                text_size: self.size
                valign: 'middle'
        
        # Stories grid
        GridLayout:
            cols: 2
            spacing: 20
            size_hint_y: 0.9
            
            Button:
                text: 'Story 1'
                background_color: (1, 1, 1, 1)
                on_release: root.open_story(1)
            
            Button:
                text: 'Story 2'
                background_color: (1, 1, 1, 1)
                on_release: root.open_story(2)
            
            Button:
                text: 'Story 3'
                background_color: (1, 1, 1, 1)
                on_release: root.open_story(3)
            
            Button:
                text: 'Story 4'
                background_color: (1, 1, 1, 1)
                on_release: root.open_story(4)

# Games Screen
<GamesScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 20
        
        # Header with back button
        BoxLayout:
            size_hint_y: 0.1
            spacing: 10
            
            Button:
                text: '← Back'
                size_hint: None, None
                size: 150, 60
                background_color: blue_color
                color: (1, 1, 1, 1)
                on_release: app.root.current = 'home'
            
            Label:
                text: 'Games'
                font_size: '36sp'
                bold: True
                size_hint_x: 1
                halign: 'left'
                text_size: self.size
                valign: 'middle'
        
        # Games grid
        GridLayout:
            cols: 2
            spacing: 20
            size_hint_y: 0.9
            
            Button:
                text: 'Game 1'
                background_color: (1, 1, 1, 1)
                on_release: root.open_game(1)
            
            Button:
                text: 'Game 2'
                background_color: (1, 1, 1, 1)
                on_release: root.open_game(2)
            
            Button:
                text: 'Game 3'
                background_color: (1, 1, 1, 1)
                on_release: root.open_game(3)
            
            Button:
                text: 'Game 4'
                background_color: (1, 1, 1, 1)
                on_release: root.open_game(4)

# Settings Screen
<SettingsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 20
        
        # Header with back button
        BoxLayout:
            size_hint_y: 0.1
            spacing: 10
            
            Button:
                text: '← Back'
                size_hint: None, None
                size: 150, 60
                background_color: blue_color
                color: (1, 1, 1, 1)
                on_release: app.root.current = 'home'
            
            Label:
                text: 'Settings'
                font_size: '36sp'
                bold: True
                size_hint_x: 1
                halign: 'left'
                text_size: self.size
                valign: 'middle'
        
        # PIN entry
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: 0.9
            spacing: 20
            pos_hint: {'center_x': 0.5}
            size_hint_x: 0.8
            
            Label:
                text: 'Enter PIN to access settings'
                font_size: '24sp'
                size_hint_y: 0.1
            
            TextInput:
                text: root.pin_input
                password: True
                font_size: '36sp'
                multiline: False
                readonly: True
                halign: 'center'
                size_hint: None, None
                size: 200, 60
                pos_hint: {'center_x': 0.5}
            
            # Numpad
            GridLayout:
                cols: 3
                spacing: 10
                size_hint: None, None
                size: 300, 400
                pos_hint: {'center_x': 0.5}
                
                # Digits 1-9
                Button:
                    text: '1'
                    on_release: root.add_digit('1')
                    size: 80, 80
                
                Button:
                    text: '2'
                    on_release: root.add_digit('2')
                    size: 80, 80
                
                Button:
                    text: '3'
                    on_release: root.add_digit('3')
                    size: 80, 80
                
                Button:
                    text: '4'
                    on_release: root.add_digit('4')
                    size: 80, 80
                
                Button:
                    text: '5'
                    on_release: root.add_digit('5')
                    size: 80, 80
                
                Button:
                    text: '6'
                    on_release: root.add_digit('6')
                    size: 80, 80
                
                Button:
                    text: '7'
                    on_release: root.add_digit('7')
                    size: 80, 80
                
                Button:
                    text: '8'
                    on_release: root.add_digit('8')
                    size: 80, 80
                
                Button:
                    text: '9'
                    on_release: root.add_digit('9')
                    size: 80, 80
                
                # Clear, 0, Enter
                Button:
                    text: 'C'
                    background_color: yellow_color
                    on_release: root.clear_pin()
                    size: 80, 80
                
                Button:
                    text: '0'
                    on_release: root.add_digit('0')
                    size: 80, 80
                
                Button:
                    text: '✓'
                    background_color: teal_color
                    on_release: root.validate_pin()
                    size: 80, 80
